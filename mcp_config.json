{
  "github": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": ""}
  },
  "gws": {
    "command": "npx",
    "args": ["-y", "@google-cloud/gws-mcp"]
  },
  "gcp": {
    "command": "npx",
    "args": ["-y", "@google-cloud/gcloud-mcp"]
  },
  "stitch": {
    "command": "npx",
    "args": ["-y", "stitch-mcp"]
  },
  "notebooklm": {
    "command": "npx",
    "args": ["-y", "notebooklm-mcp"]
  }
}
